{
 "reference": "Isaiah 40:1–31",
 "copyright": "https://berean.bible/",
 "attribution": "",
 "paragraphs": [
  {
   "kind": "heading",
   "style": "s",
   "heading": "Prepare the Way for the LORD",
   "verses": []
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "1",
     "segments": [
      {
       "text": "“Comfort, comfort My people,”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "says your God.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "2",
     "segments": [
      {
       "text": "“Speak tenderly to Jerusalem,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and proclaim to her",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "that her forced labor has been completed;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "her iniquity has been pardoned.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "For she has received from the hand of the LORD",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "double for all her sins.”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "p",
   "heading": "",
   "verses": [
    {
     "number": "3",
     "segments": [
      {
       "text": "A voice of one calling:",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "“Prepare the way for the LORD in the wilderness;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "make a straight highway for our God in the desert.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "4",
     "segments": [
      {
       "text": "Every valley shall be lifted up,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and every mountain and hill made low;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "the uneven ground will become smooth,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and the rugged land a plain.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "5",
     "segments": [
      {
       "text": "And the glory of the LORD will be revealed,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and all humanity together will see it.”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "p",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "For the mouth of the LORD has spoken.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "heading",
   "style": "s",
   "heading": "The Enduring Word",
   "verses": []
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "6",
     "segments": [
      {
       "text": "A voice says, “Cry out!”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "And I asked, “What should I cry out?”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "“All flesh is like grass,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and all its glory like the flowers of the field.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "7",
     "segments": [
      {
       "text": "The grass withers and the flowers fall",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "when the breath of the LORD blows on them;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "indeed, the people are grass.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "8",
     "segments": [
      {
       "text": "The grass withers and the flowers fall,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "but the word of our God stands forever.”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "heading",
   "style": "s",
   "heading": "Here Is Your God!",
   "verses": []
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "9",
     "segments": [
      {
       "text": "Go up on a high mountain,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "O Zion, herald of good news.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Raise your voice loudly,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "O Jerusalem, herald of good news.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Lift it up,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "do not be afraid!",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Say to the cities of Judah,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "“Here is your God!”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "10",
     "segments": [
      {
       "text": "Behold, the Lord GOD comes with might,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and His arm establishes His rule.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "His reward is with Him,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and His recompense accompanies Him.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "11",
     "segments": [
      {
       "text": "He tends His flock like a shepherd;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He gathers the lambs in His arms",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and carries them close to His heart.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He gently leads the nursing ewes.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "12",
     "segments": [
      {
       "text": "Who has measured the waters in the hollow of his hand,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "or marked off the heavens with the span of his hand?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Who has held the dust of the earth in a basket,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "or weighed the mountains on a scale",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and the hills with a balance?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "13",
     "segments": [
      {
       "text": "Who has directed the Spirit of the LORD,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "or informed Him as His counselor?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "14",
     "segments": [
      {
       "text": "Whom did He consult to enlighten Him,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and who taught Him the paths of justice?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Who imparted knowledge to Him",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and showed Him the way of understanding?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "15",
     "segments": [
      {
       "text": "Surely the nations are like a drop in a bucket;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "they are considered a speck of dust on the scales;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He lifts up the islands",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "like fine dust.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "16",
     "segments": [
      {
       "text": "Lebanon is not sufficient for fuel,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "nor its animals enough for a burnt offering.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "17",
     "segments": [
      {
       "text": "All the nations are as nothing before Him;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He regards them as nothingness and emptiness.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "18",
     "segments": [
      {
       "text": "To whom will you liken God?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "To what image will you compare Him?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "19",
     "segments": [
      {
       "text": "To an idol that a craftsman casts",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and a metalworker overlays with gold",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and fits with silver chains?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "20",
     "segments": [
      {
       "text": "One lacking such an offering",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "chooses wood that will not rot.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He seeks a skilled craftsman",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "to set up an idol that will not topple.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "21",
     "segments": [
      {
       "text": "Do you not know?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Have you not heard?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Has it not been declared to you from the beginning?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Have you not understood since the foundation of the earth?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "22",
     "segments": [
      {
       "text": "He sits enthroned above the circle of the earth;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "its dwellers are like grasshoppers.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He stretches out the heavens like a curtain,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and spreads them out like a tent to dwell in.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "23",
     "segments": [
      {
       "text": "He brings the princes to nothing",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and makes the rulers",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "of the earth meaningless.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "24",
     "segments": [
      {
       "text": "No sooner are they planted, no sooner are they sown,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "no sooner have their stems taken root in the ground,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "than He blows on them and they wither,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and a whirlwind sweeps them away like stubble.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "25",
     "segments": [
      {
       "text": "“To whom will you liken Me,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "or who is My equal?” asks the Holy One.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "26",
     "segments": [
      {
       "text": "Lift up your eyes on high:",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Who created all these?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He leads forth the starry host by number;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He calls each one by name.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Because of His great power and mighty strength,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "not one of them is missing.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "27",
     "segments": [
      {
       "text": "Why do you say, O Jacob,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and why do you assert, O Israel,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "“My way is hidden from the LORD,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and my claim is ignored by my God”?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "28",
     "segments": [
      {
       "text": "Do you not know?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Have you not heard?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "The LORD is the everlasting God,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "the Creator of the ends of the earth.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He will not grow tired or weary;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "His understanding is beyond searching out.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "29",
     "segments": [
      {
       "text": "He gives power to the faint",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and increases the strength of the weak.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "30",
     "segments": [
      {
       "text": "Even youths grow tired and weary,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and young men stumble and fall.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "31",
     "segments": [
      {
       "text": "But those who wait upon the LORD will renew their strength;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "they will mount up with wings like eagles;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "they will run and not grow weary,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "they will walk and not faint.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  }
 ]
}
