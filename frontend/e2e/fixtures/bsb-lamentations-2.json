{
 "reference": "Lamentations 2:1–22",
 "copyright": "https://berean.bible/",
 "attribution": "",
 "paragraphs": [
  {
   "kind": "heading",
   "style": "s",
   "heading": "God’s Anger over Jerusalem",
   "verses": []
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "1",
     "segments": [
      {
       "text": "How",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "the Lord has covered the Daughter of Zion",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "with the cloud of His anger!",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has cast the glory of Israel",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "from heaven to earth.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has abandoned His footstool",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "in the day of His anger.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "2",
     "segments": [
      {
       "text": "Without pity the Lord has swallowed up",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "all the dwellings of Jacob.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "In His wrath He has demolished",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "the fortified cities of the Daughter of Judah.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He brought to the ground and defiled",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "her kingdom and its princes.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "3",
     "segments": [
      {
       "text": "In fierce anger He has cut off",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "every horn",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "of Israel",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and withdrawn His right hand",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "at the approach of the enemy.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has burned in Jacob like a flaming fire",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "that consumes everything around it.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "4",
     "segments": [
      {
       "text": "He has bent His bow like an enemy;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "His right hand is positioned.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Like a foe He has killed",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "all who were pleasing to the eye;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has poured out His wrath like fire",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "on the tent of the Daughter of Zion.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "5",
     "segments": [
      {
       "text": "The Lord is like an enemy;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has swallowed up Israel.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has swallowed up all her palaces",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and destroyed her strongholds.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has multiplied mourning and lamentation",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "for the Daughter of Judah.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "6",
     "segments": [
      {
       "text": "He has laid waste His tabernacle like a garden booth;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has destroyed His place of meeting.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "The LORD has made Zion forget",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "her appointed feasts and Sabbaths.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "In His fierce anger",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has despised both king and priest.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "7",
     "segments": [
      {
       "text": "The Lord has rejected His altar;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has abandoned His sanctuary;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has delivered the walls of her palaces",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "into the hand of the enemy.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "They have raised a shout in the house of the LORD",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "as on the day of an appointed feast.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "8",
     "segments": [
      {
       "text": "The LORD determined to destroy",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "the wall of the Daughter of Zion.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He stretched out a measuring line",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and did not withdraw His hand from destroying.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He made the ramparts and walls lament;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "together they waste away.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "9",
     "segments": [
      {
       "text": "Her gates have sunk into the ground;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has destroyed and shattered their bars.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Her king and her princes are exiled among the nations,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "the law is no more,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and even her prophets",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "find no vision from the LORD.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "10",
     "segments": [
      {
       "text": "The elders of the Daughter of Zion",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "sit on the ground in silence.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "They have thrown dust on their heads",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and put on sackcloth.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "The young women of Jerusalem",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "have bowed their heads to the ground.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "11",
     "segments": [
      {
       "text": "My eyes fail from weeping;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "I am churning within.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "My heart is poured out in grief",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "over the destruction of the daughter of my people,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "because children and infants faint",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "in the streets of the city.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "12",
     "segments": [
      {
       "text": "They cry out to their mothers:",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "“Where is the grain and wine?”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "as they faint like the wounded",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "in the streets of the city,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "as their lives fade away",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "in the arms of their mothers.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "13",
     "segments": [
      {
       "text": "What can I say for you?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "To what can I compare you,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "O Daughter of Jerusalem?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "To what can I liken you,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "that I may console you,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "O Virgin Daughter of Zion?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "For your wound is as deep as the sea.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Who can ever heal you?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "14",
     "segments": [
      {
       "text": "The visions of your prophets",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "were empty and deceptive;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "they did not expose your guilt",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "to ward off your captivity.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "The burdens they envisioned for you",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "were empty and misleading.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "15",
     "segments": [
      {
       "text": "All who pass by",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "clap their hands at you in scorn.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "They hiss and shake their heads",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "at the Daughter of Jerusalem:",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "“Is this the city that was called",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "the perfection of beauty,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "the joy of all the earth?”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "16",
     "segments": [
      {
       "text": "All your enemies",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "open their mouths against you.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "They hiss and gnash their teeth,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "saying, “We have swallowed her up.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "This is the day for which we have waited.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "We have lived to see it!”",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "17",
     "segments": [
      {
       "text": "The LORD has done what He planned;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has accomplished His decree,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "which He ordained in days of old;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has overthrown you without pity.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "He has let the enemy gloat over you",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and exalted the horn",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "of your foes.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "18",
     "segments": [
      {
       "text": "The hearts of the people",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "cry out to the Lord.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "O wall of the Daughter of Zion,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "let your tears run down like a river",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "day and night.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Give yourself no relief,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "and your eyes no rest.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "19",
     "segments": [
      {
       "text": "Arise, cry out in the night",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "from the first watch of the night.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Pour out your heart like water",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "in the presence of the Lord.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Lift up your hands to Him",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "for the lives of your children",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "who are fainting from hunger",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "on the corner of every street.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "20",
     "segments": [
      {
       "text": "Look, O LORD, and consider:",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Whom have You ever treated like this?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Should women eat their offspring,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "the infants they have nurtured?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "Should priests and prophets be killed",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "in the sanctuary of the Lord?",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "21",
     "segments": [
      {
       "text": "Both young and old lie together",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "in the dust of the streets.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "My young men and maidens",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "have fallen by the sword.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "You have slain them in the day of Your anger;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "You have slaughtered them without compassion.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": "22",
     "segments": [
      {
       "text": "You summoned my terrors on every side,",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "as for the day of an appointed feast.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "In the day of the LORD’s anger",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "no one escaped or survived;",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q1",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "my enemy has destroyed",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  },
  {
   "kind": "text",
   "style": "q2",
   "heading": "",
   "verses": [
    {
     "number": null,
     "segments": [
      {
       "text": "those I nurtured and reared.",
       "wj": false,
       "italic": false
      }
     ]
    }
   ]
  }
 ]
}
