{
  "name": "scripture-journal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test src/**/*.test.ts",
    "gen:types": "mkdir -p node_modules/.cache && (cd ../backend && .venv/bin/python -c 'import json; from app.main import app; print(json.dumps(app.openapi()))') > node_modules/.cache/openapi.json && openapi-typescript node_modules/.cache/openapi.json -o src/lib/api-schema.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
