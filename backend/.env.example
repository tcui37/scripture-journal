# Both keys are optional — without them the app still runs on the keyless
# sources (bible.helloao.org and bible-api.com). Each key adds its own
# translations; a source with no key is simply not offered.

# api.bible key, free at https://scripture.api.bible/
# Adds the NIV, KJV, ASV, WEB and ~245 other Bibles.
# Note: billed per request against a monthly quota, and a passage costs one
# request per chapter.
API_BIBLE_KEY=

# Crossway key, free for non-commercial use at https://api.esv.org/
# Adds the ESV. Rate limited to 60/min, 1,000/hour, 5,000/day.
ESV_API_KEY=

# Set true only in local .env, on a machine only you use. api.bible's §12 DRM
# clause requires printing limits so that "end users" cannot copy licensed
# text; with no end users but you, its 100-verse print cap is lifted. Crossway's
# 500-verse ESV cap is NOT lifted — it restricts the licensee directly.
#
# Vercel production and preview always force this off, even if copied from
# .env or set true by mistake. Do not set SINGLE_USER=true on Vercel.
# `vercel dev` (VERCEL_ENV=development) is treated as local and honors this.
# SINGLE_USER=false

# Optional overrides, shown with their defaults.
# API_BIBLE_BASE_URL=https://rest.api.bible/v1
# CORS_ORIGINS=["http://localhost:3000"]
# REQUEST_TIMEOUT=20.0

# Supabase — used only by the backend. The browser never talks to Supabase.
# From the scripture-journal project: https://supabase.com/dashboard/project/gcpjerxfuaomyejrwhat
SUPABASE_URL=
SUPABASE_ANON_KEY=
