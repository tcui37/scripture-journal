{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,.venv/**,.pytest_cache/**,.ruff_cache/**,.mypy_cache/**,**/.env,**/.env.local,**/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
